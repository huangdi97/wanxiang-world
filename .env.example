# Wanxiang local environment template.
# Copy to .env for local runs. NEVER commit real secrets.
# Local deterministic tests do NOT require any of these values.

WANXIANG_ENV=development
WANXIANG_LOG_LEVEL=INFO
WANXIANG_DATABASE_URL=sqlite:///./data/wanxiang.db
WANXIANG_LOG_JSON=false

# Placeholder only ? replace with a real secret outside the repository.
WANXIANG_SECRET_PLACEHOLDER=
